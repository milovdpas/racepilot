# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
# ...but keep the shareable template
!.env.local.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts
client_secret*
WhatsApp*
split-screenshots/
pace-screenshots/
*.traineddata

# Raw plan exports. These carry the exporter's home coordinates in every
# weather snapshot, so they must never be committed. To refresh the bundled
# demo plan, run: node scripts/scrub-example-plan.mjs <export.json>
#
# Both names are listed: the app writes racepilot-plans-* now, and the old
# marathon-plans-* pattern stays so an export taken before the rename is still
# ignored. Never narrow this.
racepilot-plans-*.json
marathon-plans-*.json

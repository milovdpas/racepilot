# The site's own public origin, no trailing slash. Every canonical URL, the
# sitemap, robots.txt and the social preview image are built from it.
#
# Required when self-hosting. Without it the app falls back to
# http://localhost:3000 — and rather than advertise that as its canonical URL,
# it marks itself noindex, so a live site set up without this will not be
# indexed. (On Vercel this can be left unset; the platform supplies it.)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Optional. Set to 1 to show the "buy me a water" button in Settings; 0, empty
# or unset hides it. Off by default on purpose: a self-hosted copy should not
# ship a donate link pointing at this project's account.
#
# Build-time, like NEXT_PUBLIC_SITE_URL above: the NEXT_PUBLIC_ prefix is what
# inlines it into the bundle, so changing it means rebuilding the image rather
# than restarting the container.
NEXT_PUBLIC_DONATE_LINK_ENABLED=0

# Optional — enables Google Drive cloud sync (server-side OAuth).
# Leave these unset and the app works fine using localStorage only.
#
# Create an OAuth Client ID of type "Web application" in Google Cloud Console,
# add the redirect URI(s) below to it, and publish the consent screen to
# production (Testing mode expires refresh tokens after 7 days).
# See the "Cloud sync setup" section in README.md for step-by-step instructions.

# From the OAuth client (Web application). The secret is confidential — never
# prefix it with NEXT_PUBLIC_ and never commit it.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Must EXACTLY match an Authorized redirect URI on the OAuth client.
# Dev default; in production set it to https://<your-domain>/api/auth/google/callback
GOOGLE_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# Secret used to encrypt the session cookie. Must be at least 32 characters.
# Generate one with:  openssl rand -base64 32
SESSION_SECRET=

# Optional — enables per-workout weather + the calendar weather display.
# Requires an OpenWeatherMap "One Call by Call" subscription (a credit card is
# required even for the free 1000 calls/day). Set a "Calls per day" cap in your
# OWM dashboard to stay within the free limit. Server-only — never NEXT_PUBLIC_.
OPENWEATHER_API_KEY=
